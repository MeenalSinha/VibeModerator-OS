{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@vibemod/shared/*": ["../../packages/shared/src/*"],
      "@vibemod/ai-engine/*": ["../../packages/ai-engine/src/*"],
      "@vibemod/db/*": ["../../packages/db/src/*"],
      "@vibemod/queue/*": ["../../packages/queue/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
