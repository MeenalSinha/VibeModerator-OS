# ============================================================
# VibeModerator OS — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Backend ------------------------------------------------
NODE_ENV=development
PORT=8080

# PostgreSQL connection string
DATABASE_URL=postgresql://vibemod:vibemod_dev_password@localhost:5432/vibemod

# Redis connection string
REDIS_URL=redis://localhost:6379

# JWT secret for API auth (generate with: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# OpenAI API key (required for AI features)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Devvit API secret (shared between backend and Devvit app)
DEVVIT_API_SECRET=devvit-secret-change-in-production

# ---- Frontend -----------------------------------------------
VITE_API_URL=http://localhost:8080

# ---- Reddit OAuth2 (production) ----------------------------
# REDDIT_CLIENT_ID=your-reddit-app-client-id
# REDDIT_CLIENT_SECRET=your-reddit-app-client-secret
# REDDIT_REDIRECT_URI=https://your-domain.com/api/v1/auth/callback

# ---- Devvit App --------------------------------------------
# Set these in the Devvit settings panel, not here
# VIBEMOD_BACKEND_URL=https://your-backend.example.com
# VIBEMOD_API_SECRET=devvit-secret-change-in-production
